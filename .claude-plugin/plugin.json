{
  "name": "farmout",
  "version": "0.1.0",
  "description": "Hit your limit less: Claude Code hands long reads, reviews and boilerplate to your other AI subscriptions (Codex, Gemini, GitHub Copilot, a second Claude), read-only by default, and a task at its limit moves to the next one. Standard-library Python, no dependencies.",
  "author": {
    "name": "Jay Pokale",
    "url": "https://github.com/JayPokale"
  },
  "repository": "https://github.com/JayPokale/farmout",
  "license": "MIT",
  "keywords": [
    "mcp",
    "delegation",
    "multi-agent",
    "code-review",
    "codex",
    "antigravity",
    "gemini",
    "copilot",
    "usage-limits"
  ],
  "mcpServers": {
    "farmout": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server.py"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/read_guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/relay.py\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
